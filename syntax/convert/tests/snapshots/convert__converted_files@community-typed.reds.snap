// Conversions that depend on type information: converted with the types recorded by the
// compiler, most of the warnings of the untyped conversion go away
@module "MyMod.Typed"

enum EMode {
  Idle = 0,
  Busy = 1,
}

struct Size {
  public let X: Float;
  public let Y: Float;
}

public class Widget {
  public let names: array<CName>;

  public function GetSize() -> Size {
    return Size(1.0, 2.0);
  }

  public function GetNames() -> array<CName> {
    return this.names;
  }

  public function GetCount() -> Int32 {
    return this.names.Size();
  }

  public function SetSize(x: Float, y: Float) {
  }
}

function Log(text: String) {
}

function Scale(factor: Float) -> Float {
  return factor;
}

function Apply(mode: EMode) {
}

function Typed(
  w: Widget,
  weak: wref<Widget>,
  r: script_ref<Int32>,
  ratio: Float,
  flag: Bool,
  id: CName,
  v: Variant
) -> Float {
  // objects in conditions
  if (IsDefined(w)) {
    w.SetSize(445, -125);
  } else if (IsDefined(weak)) {
    Log(ToString(w.GetCount()));
  }
  // the truthiness of a negated object is not documented for REDmod
  if (!IsDefined(w)) {
    return 0;
  }
  let count: Int32 = w.GetCount();
  let names: array<CName> = w.GetNames();
  let size: Size = w.GetSize();
  let y: Float = size.Y;
  if (names.Contains(n"a")) {
    Log(ToString(ratio));
  }
  Log(ToString(flag));
  Log(ToString(id));
  Log(ToString(IntToString(count)));
  let value: Int32 = Deref(r);
  Apply(IntEnum(1));
  let scaled: Float = Scale(FromVariant(v));
  let arr: array<CName> = w.GetNames();
  let i: Int32 = 0;
  while (i < arr.Size()) {
    let name_: CName = arr[i];
    i += 1;
    Log(ToString(name_));
  }
  while (flag) {
    // reset every iteration in the community dialect
    let mode: EMode;
    let other: Widget = NULL;
    let current: Size;
    mode = EMode.Busy;
    other = w;
    current = size;
    flag = false;
  }
  Log(
    IntToString(count) + " at " + FloatToString(ratio) + " for " + NameToString(id)
  );
  return Scale(2) + y + size.X;
}

// ToString and interpolation by type: enums, small ints, structs with a static ToString
struct GameTime {
  public let seconds: Int32;

  public static function ToString(self: GameTime) -> String {
    return "time";
  }
}

function Describe(
  mode: EMode,
  small: Uint8,
  big: Uint32,
  time: GameTime,
  size: Size,
  w: Widget
) {
  Log(ToString(mode));
  Log(ToString(small));
  Log(ToString(big));
  Log(ToString(time));
  Log(ToString(size));
  Log(ToString(w));
  Log(
    ToString(mode)
      + " "
      + ToString(small)
      + " "
      + ToString(big)
      + " "
      + ToString(time)
      + " "
      + ToString(size)
      + " "
      + ToString(w)
  );
}


