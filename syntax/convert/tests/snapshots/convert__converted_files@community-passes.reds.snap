// License header comment
// spanning two lines
@module "MyMod.Runtime"

@using "Other.Utils"

enum EState {
  Idle = 0,
  Running = 1,
}

/// A documented class
public class Tracker extends ScriptableSystem {
  // tracked values
  private let values: array<Int32>;
  private let label: String;
  private persistent let saved: Int32;

  // inline body
  public function Count() -> Int32 {
    return this.values.Size();
  }

  public function Values() -> array<Int32> {
    return this.values;
  }

  public function Empty(flag: Bool) -> array<String> {
    let empty: array<String>;
    if (flag) {
      // early exit
      return empty;
    }
    return empty;
  }

  public function Sum(items: array<Int32>) -> Int32 {
    let total: Int32 = 0;
    // iterate the items
    let i: Int32 = 0;
    while (i < items.Size()) {
      let item: Int32 = items[i];
      i += 1;
      if (item < 0) {
        continue;
      }
      total += item;
    }
    let arr: array<Int32> = this.Values();
    let i_1: Int32 = 0;
    while (i_1 < arr.Size()) {
      let value: Int32 = arr[i_1];
      i_1 += 1;
      total += value;
    }
    return total;
  }

  public function Describe(name_: String, state: EState, ratio: Float) -> String {
    let i: Int32 = state as Int32;
    let back: EState = i as EState;
    let other: EState = 1 as EState;
    let v: Variant = ratio as Variant;
    let r: Float = v as Float;
    let big: Uint64 = Cast<Uint64>(10);
    let small: Uint32 = Cast<Uint32>(1);
    let wide: Int64 = Cast<Int64>(2);
    if (name_ == this.label || i != 2) {
      this.values.PushBack(i);
    }
    let arr: array<Int32> = this.Values();
    if (arr.Contains(3)) {
      this.values.Clear();
    }
    return name_
      + ": "
      + IntToString(i)
      + " of "
      + IntToString(this.values.Size())
      + " at "
      + FloatToString(ratio)
      + " "
      + ToString(state);
  }

  public function Shadowing(a: Int32) -> Int32 {
    let x: Int32 = a;
    if (a > 0) {
      let x_1: Int32 = a * 2;
      return x_1;
    }
    while (a > 10) {
      let x_2: Int32 = 1;
      a -= x_2;
    }
    return x;
  }

  event OnRefresh(evt: Event) {
    if (!IsDefined(evt)) {
      return;
    }
    let msg = ToString(evt);
    return;
  }
}

@wrapMethod(PlayerPuppet)
function OnGameAttached() {
  // call the original
  OnGameAttached();
  let sys: Tracker = GameInstance.GetScriptableSystemsContainer(this.GetGame()).Get(n"Tracker") as Tracker;
  let n: Int32 = sys.Count();
}

@replaceMethod(PlayerPuppet)
function GetLabel() -> String {
  return "label";
}

@addField(PlayerPuppet)
let tracker: wref<Tracker>;

@addMethod(Tracker)
function Extra() -> Int32 {
  return 1;
}

import function ScriptLog(text: String);

function Helpers(r: script_ref<Int32>, f: Float) -> Float {
  let a: Int32 = Deref(r);
  let b: Float = RoundF(f);
  let c: Int32 = Cast<Int32>((a * 2));
  let t: Tracker = new Tracker;
  let quoted: String = "say \u{22}hi\u{22}";
  let states: array<Int32> = [EState.Idle as Int32, 2];
  let cb_ = (x: Int32) -> x + 1;
  return b;
}

function Patterns(name_: CName, o: Tracker, xs: array<String>) {
  // downcast with a pattern
  let name_1: Tracker = o as Tracker;
  if (true) {
    name_1.Count();
  }
  let t: Tracker = o as Tracker;
  if (t) {
    t.Count();
  } else {
    o.Count();
  }
  let w: Tracker = o;
  if (w) {
    w.Count();
  }
  let i: Int32 = 0;
  while (i < xs.Size()) {
    let x: String = xs[i];
    i += 1;
    // reset every iteration in the community dialect
    let found: array<String>;
    found.Clear();
    let count: Int32 = 0;
    found.PushBack(x);
    count += 1;
  }
}

function ShadowedPatterns(o1: Tracker, o2: Tracker) {
  // inner patterns reuse the outer name
  let t_1: Tracker = o1 as Tracker;
  if (t_1) {
    let t_3: Tracker = o2 as Tracker;
    if (t_3) {
      t_3.Count();
    }
    t_1.Count();
  }
  let t_2: Tracker = o1 as Tracker;
  if (t_2) {
    let cb_ = (t: Int32) -> t + 1;
    t_2.Count();
  }
}

@wrapMethod(PlayerPuppet)
function OnOther() {
  OnOther();
}

