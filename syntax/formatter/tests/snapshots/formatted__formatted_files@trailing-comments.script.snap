@module "Test.Trailing"

// module comment
@using "Foo.Bar" // using comment

class Foo extends Bar {
  // class open
  let a: Int32; // field a
  let b: Int32 = 1; /* field b */

  function Run(x: Int32) -> Int32 {
    // fn open
    let y: Int32 = x + 1; // var comment
    let z: Int32 = 2; /* block */ // and line
    y += 1; // first
    // own line
    y += 2; // second
    if (y > 1) {
      // if open
      y = 0; // inner
    } else {
      // else open
      y = 1;
    } // if close
    while (y < 10) {
      // while open
      y += 1; // step
    } // while close
    let w: Int32 = x + /* mid */ y;
    for (let i: Int32 = 0; i < 3; i += 1) {
      // for open
      Log("x"); // log
    } // for close
    for (let j: Int32 = 0; /* init comment */ j < 3; j += 1) {
    }
    return y; // result
  } // fn close
} // class close

