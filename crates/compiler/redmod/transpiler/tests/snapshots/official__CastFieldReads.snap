class OfficialFieldBase extends IScriptable {
}

class OfficialFieldDerived extends OfficialFieldBase {
    public var m_count: Int32;
}

function OfficialCastField(owner: OfficialFieldBase, enabled: Bool) -> Int32 {
    if (enabled) {
        return (owner as OfficialFieldDerived).m_count;
    }
    return (NULL as OfficialFieldDerived).m_count;
}
