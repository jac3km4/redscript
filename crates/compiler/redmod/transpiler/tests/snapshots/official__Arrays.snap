function OfficialTranspileArray() -> Int32 {
    var arrayLiteral: array<Int32>;
    arrayLiteral.Resize(2);
    arrayLiteral[0] = 1;
    arrayLiteral[1] = 2;
    var values: array<Int32> = arrayLiteral;
    values.PushBack(3);
    return values.Size();
}
