function OfficialTranspileArray() -> Int32 {
    var valuesLiteral: array<Int32>;
    valuesLiteral.Resize(2);
    valuesLiteral[0] = 1;
    valuesLiteral[1] = 2;
    var values: array<Int32> = valuesLiteral;
    values.PushBack(3);
    return values.Size();
}
