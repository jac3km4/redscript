class OfficialUnaryArrayOwner extends IScriptable {
    public var m_values: array<Int32>;
}

function OfficialFieldClear(owner: OfficialUnaryArrayOwner) -> Void {
    owner.m_values.Clear();
}

function OfficialFieldPop(owner: OfficialUnaryArrayOwner) -> Int32 {
    return owner.m_values.PopBack();
}

function OfficialFieldLast(owner: OfficialUnaryArrayOwner) -> Int32 {
    return owner.m_values.Last();
}
