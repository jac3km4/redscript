source: crates/compiler/redmod/transpiler/tests/official.rs
expression: source.module.text
---
struct OfficialScriptLeaf {
    public var m_count: Int32;
}

struct OfficialScriptValue {
    public var m_leaf: OfficialScriptLeaf;
    public var m_text: String;
    public var m_values: array<Int32>;
    public var m_dynamic: Variant;
}

function OfficialScriptDefault(again: Bool) -> OfficialScriptValue {
    var repeated: OfficialScriptValue;
    var value: OfficialScriptValue = OfficialScriptValue();
    while (again) {
        repeated = OfficialScriptValue();
        repeated.m_text = "dirty";
        value = repeated;
    }
    return value;
}
