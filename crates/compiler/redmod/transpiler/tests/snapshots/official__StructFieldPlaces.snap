struct OfficialPlaceInner {
    public var m_count: Int32;
}

struct OfficialPlaceOuter {
    public var m_inner: OfficialPlaceInner;
}

class OfficialPlaceOwner extends IScriptable {
    public var m_value: OfficialPlaceOuter;
}

function OfficialPlaceSet(out value: Int32) -> Void {
    value = 42;
}

function OfficialStructPlaces(owner: OfficialPlaceOwner, value: script_ref<OfficialPlaceOuter>) -> Void {
    owner.m_value.m_inner.m_count = 41;
    OfficialPlaceSet(owner.m_value.m_inner.m_count);
    value.m_inner.m_count = 43;
    OfficialPlaceSet(value.m_inner.m_count);
}
