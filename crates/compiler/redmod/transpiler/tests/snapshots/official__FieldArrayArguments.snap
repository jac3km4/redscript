---
source: crates/compiler/redmod/transpiler/tests/official.rs
expression: source.module.text
---
struct OfficialArgumentData {
    public var m_address: String;
}

class OfficialArgumentArrayOwner extends IScriptable {
    public var m_addresses: array<String>;

    public function HasAddress(data: OfficialArgumentData) -> Bool {
        return this.m_addresses.Contains(data.m_address);
    }

    public function PushIndexed(index: Int32) -> Void {
        this.m_values.PushBack(this.m_values[index]);
    }

    public var m_values: array<Int32>;
    public var m_listeners: array<wref<OfficialArgumentArrayOwner>>;
    public var m_strong: array<OfficialArgumentArrayOwner>;

    public function AddWeak(listener: wref<OfficialArgumentArrayOwner>) -> Void {
        this.m_strong.PushBack(listener);
    }

    public function Add(listener: OfficialArgumentArrayOwner) -> Void {
        this.m_listeners.PushBack(listener);
        this.m_listeners.Contains(listener);
        this.m_listeners.Remove(listener);
    }
}

function OfficialFieldArguments(owner: OfficialArgumentArrayOwner, value: Int32) -> Void {
    owner.m_values.Resize(3);
    owner.m_values.Grow(value);
    owner.m_values.Count(value);
    owner.m_values.FindFirst(value);
    owner.m_values.FindLast(value);
    owner.m_values.Contains(value);
    owner.m_values.PushBack(value);
    owner.m_values.Insert(0, value);
    owner.m_values.Remove(value);
    owner.m_values.Erase(0);
}
