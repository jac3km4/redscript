class OfficialArrayOwner extends IScriptable {
    public var m_values: array<Int32>;
    public var m_child: OfficialArrayOwner;

    public function Next() -> OfficialArrayOwner {
        return this.m_child;
    }
}

function OfficialFieldArraySize(owner: OfficialArrayOwner, enabled: Bool) -> Int32 {
    if (enabled) {
        return owner.m_child.m_values.Size();
    }
    return owner.m_values.Size();
}
