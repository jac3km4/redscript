---
source: crates/compiler/redmod/transpiler/tests/official.rs
expression: source.module.text
---
struct OfficialIndexedValue {
    public var m_count: Int32;
}

class OfficialIndexedBorrowOwner extends IScriptable {
    public var m_values: array<OfficialIndexedValue>;
}

function OfficialIndexedSet(value: script_ref<OfficialIndexedValue>) -> Void {
    value.m_count = 42;
}

function OfficialBorrowIndex(out index: Int32) -> Int32 {
    index = 1;
    return 0;
}

function OfficialIndexedBorrow(owner: OfficialIndexedBorrowOwner, index: Int32) -> Void {
    OfficialIndexedSet(owner.m_values[OfficialBorrowIndex(index)]);
}
