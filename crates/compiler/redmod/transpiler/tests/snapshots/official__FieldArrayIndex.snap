class OfficialIndexOwner extends IScriptable {
    public var values: array<Int32>;
    public var child: OfficialIndexOwner;
}

function OfficialFieldIndex(owner: OfficialIndexOwner, index: Int32) -> Int32 {
    owner.child.values[index] = 42;
    return owner.values[index];
}
