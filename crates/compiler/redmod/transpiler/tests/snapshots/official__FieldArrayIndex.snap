class OfficialIndexOwner extends IScriptable {
    public var m_values: array<Int32>;
    public var m_child: OfficialIndexOwner;
}

function OfficialFieldIndex(owner: OfficialIndexOwner, index: Int32) -> Int32 {
    owner.m_child.m_values[index] = 42;
    return owner.m_values[index];
}
