class OfficialOutOwner extends IScriptable {
    public var m_count: Int32;
    public var m_child: OfficialOutOwner;

    public function Next() -> OfficialOutOwner {
        return this.m_child;
    }
}

function OfficialSetOut(out value: Int32) -> Void {
    value = 42;
}

function OfficialFieldOut(owner: OfficialOutOwner, handle: wref<OfficialOutOwner>) -> Void {
    OfficialSetOut(owner.m_count);
    OfficialSetOut(owner.m_child.m_count);
    OfficialSetOut(handle.m_count);
    OfficialSetOut(owner.Next().m_count);
}
